{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!**/worker-configuration.d.ts",
      "!**/migrations/meta",
      "!**/*.lock",
      "!**/dist"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Only class/className sorting (linter: useTailwindSortedClasses) is enabled.
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedEnumMembers": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off",
        "useSortedSelectionSet": "off",
        "useGraphqlSortedDefinitions": "off",
        "useGraphqlSortedVariables": "off",
        "useGraphqlSortedArguments": "off",
        "useSortedPackageJson": "off"
      }
    }
  },
  "overrides": [
    // Preserve existing inline event handlers; extracting callbacks changes application code.
    {
      "includes": [
        "src/components/click-counter.tsx",
        "src/components/post-id-form.tsx"
      ],
      "linter": { "rules": { "performance": { "noJsxPropsBind": "off" } } }
    },
    // Preserve indexed parser access and positional regex captures without rewriting application code.
    {
      "includes": ["src/lib/markdown/frontmatter.ts"],
      "linter": {
        "rules": {
          "style": { "useDestructuring": "off", "useNamedCaptureGroup": "off" }
        }
      }
    },
    // Preserve the existing route-result access without rewriting application code.
    {
      "includes": ["src/lib/markdown/routes.tsx"],
      "linter": { "rules": { "style": { "useDestructuring": "off" } } }
    }
  ]
}
