{
  "name": "hono-rsc-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && echo 'import handler from \"./rsc/index.js\"; export default { fetch: handler };' > dist/worker-entry.js",
    "test": "vitest run",
    "preview": "NODE_ENV=production wrangler dev --local --port 8787",
    "deploy": "bun run build && wrangler deploy",
    "check": "ultracite check",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@yoshikouki/hono-file-router": "github:yoshikouki/hono-kit#main",
    "@yoshikouki/hono-rsc-renderer": "github:yoshikouki/hono-kit#main",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "rehype-react": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/workers-types": "^4.20260624.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.39",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3",
    "ultracite": "8.2.0",
    "vite": "^8.1.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.104.0"
  },
  "patchedDependencies": {
    "hono-kit@github:yoshikouki/hono-kit#9653c8a": "patches/hono-kit@github%3Ayoshikouki%2Fhono-kit#9653c8a.patch",
    "rehype-react@8.0.0": "patches/rehype-react@8.0.0.patch"
  }
}
